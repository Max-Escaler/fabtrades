# Uncomment this line to define a global platform for your project.
# google_mlkit_commons requires iOS 15.5+.
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

# Resolve google_mlkit_commons from package_config so this works even when
# ios/.symlinks has not been regenerated yet (chicken-and-egg with pod install).
require 'json'
_mlkit_package_config = JSON.parse(File.read(File.expand_path('../.dart_tool/package_config.json', __dir__)))
_mlkit_commons = _mlkit_package_config['packages'].find { |p| p['name'] == 'google_mlkit_commons' }
raise 'google_mlkit_commons missing from .dart_tool/package_config.json; run flutter pub get' unless _mlkit_commons
require File.expand_path(
  'ios/scripts/apple_silicon_simulator',
  _mlkit_commons['rootUri'].sub(%r{\Afile://}, ''),
)

flutter_ios_podfile_setup

target 'Runner' do
  # Static linkage avoids the missing Pods_Runner.framework link failure that
  # shows up when Flutter's SPM plugin integration is mixed with dynamic pods.
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.5
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
      end
    end
  end

  # Relabel ML Kit arm64 device slices for Apple Silicon simulators (iOS 26+)
  # and strip EXCLUDED_ARCHS arm64 from generated xcconfigs. See
  # google_mlkit_commons README "Apple Silicon iOS Simulator".
  mlkit_apple_silicon_simulator_patch(installer)
end
